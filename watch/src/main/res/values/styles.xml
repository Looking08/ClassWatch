<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 手表屏幕就 466×466，顶部那一条系统 ActionBar（会显示 App 名「课表」）
         纯属浪费地方，所以统一用无标题栏主题。 -->
    <style name="Theme.ClassWatch.NoActionBar" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
